{
  "name": "@mel-company/storefront-ui",
  "version": "0.1.0",
  "description": "Storefront UI library for developers and AI agents: components, sections and pages with built-in checkers, theming and dark mode.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/storefront-ui.js",
  "module": "./dist/storefront-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/storefront-ui.js"
    },
    "./style.css": "./dist/style.css",
    "./catalogue.json": "./dist/catalogue.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && npm run catalogue",
    "build:site": "vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "vite-node scripts/check.ts",
    "catalogue": "vite-node scripts/catalogue.ts",
    "mcp": "vite-node mcp/server.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
