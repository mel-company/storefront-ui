{
  "name": "@mel-company/storefront-ui",
  "version": "0.1.0",
  "description": "Storefront UI for developers and AI agents: a small core package (theme, store contract, renderers, checkers' schemas) plus components, sections and pages you copy into your project with `npx storefront-ui add`.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/storefront-ui.cjs",
  "module": "./dist/storefront-ui.js",
  "types": "./dist/types/package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/package.d.ts",
      "import": "./dist/storefront-ui.js",
      "require": "./dist/storefront-ui.cjs"
    },
    "./demo": {
      "types": "./dist/types/demo/index.d.ts",
      "import": "./dist/demo.js",
      "require": "./dist/demo.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin"
  ],
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "npm run registry && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "vite-node scripts/check.ts",
    "mcp": "vite-node mcp/server.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check",
    "prepublishOnly": "npm run verify && npm run build",
    "registry": "vite-node scripts/registry.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-direction": "1.1.5",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-accordion": "1.2.21",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "html-to-image": "^1.11.13",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mel-company/storefront-ui.git"
  },
  "homepage": "https://storefront-ui-x.vercel.app",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "storefront-ui": "./bin/storefront-ui.mjs"
  }
}
